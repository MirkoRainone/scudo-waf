# Storage backend: auto | memory | sqlite | supabase
# Use SCUDO_STORAGE_MODE=sqlite for single-node persistent storage, or memory for ephemeral CI/testing
SCUDO_STORAGE_MODE=memory
SCUDO_SQLITE_PATH=./ai_detector/scudo_control_plane.db
SCUDO_DEMO_API_KEY=sk_test_default
SCUDO_ADMIN_SECRET=
WAF_API_KEY=sk_test_default

# Microservice Wiring
SCUDO_API_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8501

# Optional Supabase Cloud Persistence
SUPABASE_URL=
SUPABASE_KEY=

# Optional Stripe Checkout & Signed Webhook Lifecycle (Pro Tier)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
