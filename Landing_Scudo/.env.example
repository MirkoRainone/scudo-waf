# Control Plane & Dashboard URLs
SCUDO_API_URL=http://localhost:8000
SCUDO_ADMIN_SECRET=
DASHBOARD_URL=http://localhost:8501

# WAF API key used by the landing page middleware
WAF_API_KEY=sk_test_default

# Storage Persistence (sqlite | memory)
SCUDO_STORAGE_MODE=sqlite
SCUDO_SQLITE_PATH=./scudo_landing.db

# Optional Supabase Cloud Persistence (Waitlist + API Keys mirror)
SUPABASE_URL=
SUPABASE_KEY=

# Optional Transactional Email Delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scudo WAF <onboarding@resend.dev>

# Stripe Checkout, Customer Portal & Signed Webhook Lifecycle (Pro & Agency Tiers)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_PRO_PAYMENT_LINK=
STRIPE_AGENCY_PAYMENT_LINK=
STRIPE_CUSTOMER_PORTAL_URL=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/?checkout=success
STRIPE_CANCEL_URL=http://localhost:8080/?checkout=cancelled
